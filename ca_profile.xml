<?xml version="1.0"?>
<Container version="2">
<Profile>
    <Name>MediaHub</Name>
    <Description>Configuration profile for the new repository submission.</Description>
</Profile>
  <Name>mediahub</Name>
  <Repository>ghcr.io/bdlnaredi/mediahub:latest</Repository>
  <Registry/>
  <Network>bridge</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Project/>
  <ReadMe/>
  <Overview/>
  <Category/>
  <WebUI>http://[IP]:[PORT:5080]</WebUI>
  <TemplateURL/>
  <Icon></Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled></DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="web port" Target="8080" Default="" Mode="tcp" Description="" Type="Port" Display="always" Required="false" Mask="false">5080</Config>
  <Config Name="config" Target="/data" Default="" Mode="rw" Description="" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/appdata/mediahub</Config>
  <TailscaleStateDir/>
</Container>